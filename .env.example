# Environment production untuk docker-compose.prod.yml
# Salin menjadi .env lalu isi nilai sebenarnya. Jangan commit file .env.

# PostgreSQL
DB_USER=postgres
DB_NAME=rscb_deployment
DB_PASSWORD=change-me

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=rscb-artifacts
MINIO_USE_SSL=false
# URL publik MinIO yang dipakai untuk presigned download URL agent.
MINIO_PUBLIC_URL=https://minio.example.com

# Backend
JWT_SECRET=change-me-random-secret
JWT_EXPIRES_IN=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# CI/CD
CI_API_KEY=change-me-ci-key
# Ukuran part chunked upload (byte). Default 16 MiB, minimum 5 MiB.
CI_PART_SIZE=16777216

# Port publik
API_PORT=3000
WEB_PORT=80
