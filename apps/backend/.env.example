NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:Tigerlake.85@localhost:5432/rscb_deployment

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# API key untuk endpoint CI (header x-api-key, scope /api/v1/ci/*)
CI_API_KEY=change-me-in-production
# Ukuran part chunked upload dalam byte (default 16 MiB, min 5 MiB)
CI_PART_SIZE=16777216

STORAGE_DRIVER=minio
UPLOAD_DIR=./uploads

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rscb-artifacts
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
